<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:entities="clr-namespace:Asisste.Domain.Entities;assembly=Asisste.Domain"
             xmlns:viewModels="clr-namespace:Asisste.MAUI.Features.Items.ViewModels"
             x:Class="Asisste.MAUI.Features.Items.Pages.ItemsPage"
             x:DataType="viewModels:ItemsViewModel"
             Title="{Binding Title}">
    <Grid Padding="24,20" RowDefinitions="Auto,*" RowSpacing="16">
        <Border Padding="20">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Explorar" FontSize="28" FontAttributes="Bold" />
                    <Label Text="Elementos administrados por un repositorio inyectado." Style="{StaticResource BodySecondaryLabelStyle}" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="Nuevo"
                        Command="{Binding AddItemCommand}"
                        VerticalOptions="Center" />
            </Grid>
        </Border>

        <RefreshView Grid.Row="1"
                     Command="{Binding LoadItemsCommand}"
                     IsRefreshing="{Binding IsBusy, Mode=TwoWay}">
            <CollectionView ItemsSource="{Binding Items}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                <CollectionView.EmptyView>
                    <Grid Padding="24">
                        <Label Text="No hay elementos todavía."
                               HorizontalOptions="Center"
                               Style="{StaticResource BodySecondaryLabelStyle}" />
                    </Grid>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="entities:Item">
                        <Border Margin="0,0,0,12" Padding="18">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                                <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" />
                                <Label Grid.Row="1"
                                       Text="{Binding Description}"
                                       Style="{StaticResource BodySecondaryLabelStyle}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
