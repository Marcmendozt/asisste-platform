<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Asisste.MAUI.Features.Location.ViewModels"
             x:Class="Asisste.MAUI.Features.Location.Pages.UbicacionPage"
             x:DataType="viewModels:UbicacionViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <Grid Padding="24" RowDefinitions="Auto,Auto,Auto" RowSpacing="20">
            <Border Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="72,*" ColumnSpacing="16">
                    <Border WidthRequest="72" HeightRequest="72">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <Image Source="location.svg" WidthRequest="30" HeightRequest="30" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                        <Label Text="Ubicación actual" FontSize="28" FontAttributes="Bold" />
                        <Label Text="{Binding StatusMessage}" Style="{StaticResource BodySecondaryLabelStyle}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <Border Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Latitud" Style="{StaticResource CaptionLabelStyle}" />
                        <Label Text="{Binding Latitude}" FontSize="20" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Longitud" Style="{StaticResource CaptionLabelStyle}" />
                        <Label Text="{Binding Longitude}" FontSize="20" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Precisión" Style="{StaticResource CaptionLabelStyle}" />
                        <Label Text="{Binding Accuracy}" FontSize="20" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Button Grid.Row="2"
                    Text="Obtener ubicación"
                    Command="{Binding LocateCommand}"
                    VerticalOptions="Start" />
        </Grid>
    </ScrollView>
</ContentPage>
