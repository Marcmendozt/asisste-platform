<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Asisste.MAUI</RootNamespace>
    <AssemblyName>Asisste.MAUI</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Asisste</ApplicationTitle>
    <ApplicationId>com.asisste.app</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1459B2" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F7F9FC" BaseSize="192,192" />
    <MauiImage Include="Resources\Images\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\2-Application\Asisste.Services\Asisste.Services.csproj" />
    <ProjectReference Include="..\..\1-Core\Asisste.Domain\Asisste.Domain.csproj" />
    <ProjectReference Include="..\..\3-Infrastructure\Asisste.Data\Asisste.Data.csproj" />
  </ItemGroup>

</Project>
