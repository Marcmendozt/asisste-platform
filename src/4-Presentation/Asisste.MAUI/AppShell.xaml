<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
   x:Class="Asisste.MAUI.AppShell"
       FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{StaticResource Primary}"
       Shell.ForegroundColor="{StaticResource OnPrimary}"
       Shell.TitleColor="{StaticResource OnPrimary}"
       Shell.UnselectedColor="{StaticResource PrimaryMuted}"
       Shell.TabBarBackgroundColor="{StaticResource Primary}"
       Shell.TabBarForegroundColor="{StaticResource OnPrimary}"
       Shell.TabBarTitleColor="{StaticResource OnPrimary}"
       Shell.TabBarUnselectedColor="{StaticResource PrimaryMuted}">
    <MenuItem x:Name="LogoutMenuItem"
              Text="Cerrar sesión"
              IconImageSource="lock.svg"
              Clicked="OnLogoutClicked" />
</Shell>
